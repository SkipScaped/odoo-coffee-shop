<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="pos_category_menu" model="pos.category">
        <field name="name">Coffee Shop Menu</field>
    </record>

    <record id="pos_category_drinks" model="pos.category">
        <field name="name">Drinks</field>
        <field name="parent_id" ref="coffee_shop.pos_category_menu"/>
    </record>
    <record id="pos_category_coffee" model="pos.category">
        <field name="name">Coffee</field>
        <field name="parent_id" ref="coffee_shop.pos_category_drinks"/>
    </record>
    <record id="pos_category_pastries" model="pos.category">
        <field name="name">Pastries</field>
        <field name="parent_id" ref="coffee_shop.pos_category_menu"/>
    </record>
</odoo>
